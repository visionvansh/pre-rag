JINA_MODEL_PATH=/Volumes/vision/Downloads/codes_necessary/models/jina-embeddings-v5-omni-small-retrieval-mlx
JINA_RERANKER_PATH=/Volumes/vision/Downloads/codes_necessary/models/jina-reranker-m0
WEAVIATE_HOST=127.0.0.1
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051
WEAVIATE_COLLECTION=MediaChunk
APP_DATA_DIR=./data
VIDEO_CHUNK_SECONDS=10.0
VIDEO_MAX_FRAMES=32
TRANSCRIPT_CHUNK_TOKENS=800
TRANSCRIPT_OVERLAP_TOKENS=120
SEARCH_LIMIT=12

# Parallel Jina-v4 late-interaction lab. These defaults do not alter the v5 lab.
JINA_V4_MODEL_PATH=/Volumes/vision/Downloads/codes_necessary/models/jina-embeddings-v4
JINA_V4_REVISION=853c867b65b749f3c3c72a06868140d842e04f06
JINA_V4_PYTHON_PATH=.venv-jina-v4/bin/python
JINA_V4_WORKER_TIMEOUT_SEC=1200
JINA_V4_DEVICE=auto
JINA_V4_ATTN_IMPLEMENTATION=eager
JINA_V4_TEXT_MAX_LENGTH=8192
LI_WEAVIATE_COLLECTION=JinaV4LateChunk
LI_TEXT_CHUNK_TOKENS=800
LI_TEXT_OVERLAP_TOKENS=120
LI_SEARCH_LIMIT=12
LI_LATE_CANDIDATE_LIMIT=64
LI_LATE_MAX_CANDIDATES=200
LI_M0_CANDIDATE_LIMIT=40
LI_LOW_MEMORY_MODE=false

# m0 is stage two only. Dense distance is never blended into rerank_score.
RERANKER_ENABLED=true
RERANKER_DEVICE=auto

# IMPORTANT: m0 runs in its own compatibility venv because its Qwen2-VL custom
# code/checkpoint layout is incompatible with the newer Transformers used by Jina-v5 Omni.
RERANKER_PYTHON_PATH=.venv-reranker/bin/python
RERANKER_WORKER_TIMEOUT_SEC=900

RERANKER_CANDIDATE_LIMIT=64
RERANKER_MAX_CANDIDATES=200
RERANKER_TEXT_BATCH_SIZE=4
RERANKER_IMAGE_BATCH_SIZE=1
RERANKER_TEXT_MAX_LENGTH=3072
RERANKER_IMAGE_MAX_LENGTH=4096
RERANKER_QUERY_MAX_LENGTH=512
RERANKER_ATTN_IMPLEMENTATION=eager
